# Copy this file to .env and fill in your real values
# Gmail requires an App Password (not your normal password):
# https://myaccount.google.com/apppasswords
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password

# Public URL of the site — set this to your real domain in production,
# e.g. PUBLIC_URL=https://valuegrid.com
PUBLIC_URL=http://localhost:3000

# Admin panel password — protects /admin.html and /api/admin/*
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=change_me_to_a_long_random_password
